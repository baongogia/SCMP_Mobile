{
  "name": "pool-center",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:GiaBao": "expo run:ios --device \"Gia Bao\"",
    "start:Simulator": "npx expo run:ios --device \"iPhone 17 Pro Max\" --port 18888",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "EXPO_NO_WEB=1 expo start --ios",
    "ios:run": "expo run:ios",
    "backup:zalopay": "node ./scripts/backup_zalopay.js",
    "restore:zalopay": "node ./scripts/restore_zalopay.js",
    "check:zalopay": "node ./scripts/check_zalopay.js",
    "ios:device": "npm run backup:zalopay && npx expo run:ios --device",
    "ios:simulator": "npm run backup:zalopay && npx expo run:ios --simulator",
    "ios:rebuild": "npm run backup:zalopay && cd ios && pod install && cd .. && npm run restore:zalopay && npm run check:zalopay",
    "test": "jest --watchAll",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.3.16",
    "@reduxjs/toolkit": "^2.9.0",
    "@shopify/react-native-skia": "2.2.12",
    "axios": "^1.12.2",
    "expo": "54.0.19",
    "expo-blur": "~15.0.7",
    "expo-clipboard": "^8.0.7",
    "expo-font": "~14.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-location": "~19.0.7",
    "expo-media-library": "^18.2.0",
    "expo-router": "~6.0.13",
    "expo-splash-screen": "~31.0.10",
    "expo-sqlite": "^16.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "pusher-js": "^8.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-animatable": "^1.4.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "^15.14.0",
    "react-native-toast-message": "^2.3.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli-platform-android": "^20.0.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.13",
    "react-native-debugger-open": "^0.4.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
